#!/usr/bin/env bash
# sessionStart hook: link plugin agents into $COPILOT_HOME/agents so the
# Copilot app picker and task() see file stems, then print additionalContext
# JSON for the poteto-mode mandate.
# A missing context file fails the hook. Link failures are ignored. No
# python3/node means empty stdout so the session still starts.

set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
file="$here/session-start-context.md"
test -f "$file"

copilot_home="${COPILOT_HOME:-$HOME/.copilot}"
agents_src="$(cd "$here/../agents" && pwd)"
agents_dest="$copilot_home/agents"
mkdir -p "$agents_dest"
for src in "$agents_src"/*.agent.md; do
  [ -f "$src" ] || continue
  dest="$agents_dest/$(basename "$src")"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    continue
  fi
  ln -sfn "$src" "$dest" || true
done

if command -v python3 >/dev/null 2>&1; then
  python3 -c 'import json, pathlib, sys; print(json.dumps({"additionalContext": pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")}))' "$file"
  exit 0
fi

if command -v node >/dev/null 2>&1; then
  node -e 'const fs=require("fs"); process.stdout.write(JSON.stringify({additionalContext: fs.readFileSync(process.argv[1], "utf8")}))' "$file"
  exit 0
fi

# ponytail: no python3/node on PATH. Mandate stays silent. Install either to restore auto-fire.
exit 0
