#!/usr/bin/env bash
# sessionStart hook: print Copilot additionalContext JSON for the poteto-mode mandate.
# A missing context file fails the hook. No python3/node means empty stdout so
# the session still starts.

set -euo pipefail

file="$(cd "$(dirname "$0")" && pwd)/session-start-context.md"
test -f "$file"

if command -v python3 >/dev/null 2>&1; then
  python3 -c 'import json, pathlib, sys; print(json.dumps({"additionalContext": pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")}))' "$file"
  exit 0
fi

if command -v node >/dev/null 2>&1; then
  node -e 'const fs=require("fs"); process.stdout.write(JSON.stringify({additionalContext: fs.readFileSync(process.argv[1], "utf8")}))' "$file"
  exit 0
fi

# ponytail: no python3/node on PATH. Mandate stays silent. Install either to restore auto-fire.
exit 0
